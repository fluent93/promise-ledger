    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# 🎙️ Seinfeld English — Audio-First Studio Extractor\n",
        "\n",
        "구글 드라이브의 원본 영상에서 10~20초 명장면 오디오 클립을 먼저 자르고, 오디오를 미리 듣기로 확인한 후 대사(3~4줄)를 받아적어 세트를 등록하는 역방향 제작 도구입니다."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "import os\n",
        "import json\n",
        "import subprocess\n",
        "from pathlib import Path
        "from IPython.display import Audio, display\n",
        "\n",
        "SOURCE_ROOT = Path('/content/drive/MyDrive/Seinfeld (small size_torrent)')\n",
        "OUTPUT_ROOT = Path('/content/drive/MyDrive/Seinfeld English Clips')\n",
        "OUTPUT_ROOT.mkdir(parents=True, exist_ok=True)\n",
        "print('✅ Drive mounted & ready!')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Step 1: 에피소드 파일 찾기 & 오디오 클립 추출\n",
        "EPISODE_QUERY = '028 - The Alternate Side'  # 예: 회차 번호나 제목\n",
        "START_TIME = '00:09:34.5'                 # 시작 시각 (HH:MM:SS.m)\n",
        "DURATION_SEC = 12.5                       # 잘라낼 길이 (초)\n",
        "SLUG_NAME = 'these-pretzels-are-making-me-thirsty'\n",
        "\n",
        "def find_video(query):\n",
        "    exts = {'.avi', '.mkv', '.mp4', '.m4v', '.mpg'}\n",
        "    for p in SOURCE_ROOT.rglob('*'):\n",
        "        if p.is_file() and p.suffix.lower() in exts and query.lower() in p.name.lower():\n",
        "            return p\n",
        "    raise FileNotFoundError(f'Not found: {query}')\n",
        "\n",
        "video_file = find_video(EPISODE_QUERY)\n",
        "output_mp3 = OUTPUT_ROOT / f'{SLUG_NAME}.mp3'\n",
        "\n",
        "cmd = ['ffmpeg', '-y', '-ss', START_TIME, '-i', str(video_file), '-t', str(DURATION_SEC), '-vn', '-acodec', 'libmp3lame', '-ab', '128k', '-ar', '44100', str(output_mp3)]\n",
        "subprocess.run(cmd, check=True)\n",
        "\n",
        "print(f'🎉 오디오 클립 생성 완료: {output_mp3.name}')\n",
        "display(Audio(filename=str(output_mp3)))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Step 2: 실제 오디오 들으며 대사 3~4줄 등록\n",
        "PHRASE = 'These pretzels are making me thirsty.'\n",
        "MEANING = '이 프레첼을 먹으니 목이 마르네.'\n",
        "SEASON = 3\n",
        "EPISODE = 'The Alternate Side'\n",
        "\n",
        "DIALOGUE = [\n",
        "    {'speaker': 'Kramer', 'text': 'Boy, these pretzels are making me thirsty.', 'translation': '이봐, 이 프레첼을 먹으니 목이 마르네.'},\n",
        "    {'speaker': 'George', 'text': 'Is that how you me gonna say it? That is no good.', 'translation': '그렇게 말할 생각이야? 전혀 아니잖아.'}\n",
        "]\n",
        "\n",
        "manifest_file = OUTPUT_ROOT / 'clip-manifest.json'\n",
        "manifest = {'version': 3, 'clips': {}}\n",
        "if manifest_file.exists():\n",
        "    with open(manifest_file, 'r', encoding='utf-8') as f:\n",
        "        manifest = json.load(f)\n",
        "\n",
        "manifest['clips'][PHRASE] = {\n",
        "    'src': f'/api/audio-clip?id={SLUG_NAME}',\n",
        "    'file': f'{SLUG_NAME}.mp3',\n",
        "    'episode': EPISODE,\n",
        "    'season': SEASON,\n",
        "    'dialogue': DIALOGUE\n",
        "}\n",
        "\n",
        "with open(manifest_file, 'w', encoding='utf-8') as f:\n",
        "    json.dump(manifest, f, ensure_ascii=False, indent=2)\n",
        "\n",
        "print(f'✨ 성공적으로 매니페스트에 등록되었습니다: {PHRASE}')"
      ]
    }
  ]
}
