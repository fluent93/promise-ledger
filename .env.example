# Seinfeld English Web Push
# Generate VAPID keys with: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Production subscription storage: Upstash Redis Free REST.
# Keep this on the Free plan without a payment method. One user and one daily
# send use roughly 120 scheduled commands/month, far below the free allowance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local-only fallback storage used by npm run dev:11
LOCAL_PUSH_STORE_FILE=.tmp/seinfeld-english-subscriptions.json

# Public app path used inside push notifications.
# The deployed route remains /daily-verse/ so existing installations keep working.
DAILY_ENGLISH_APP_URL=/daily-verse/

# Protect scheduled send endpoints
CRON_SECRET=
